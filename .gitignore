*.onnx
**/bbpe.model

# Only arm64 is packaged by the Android app; keep other ABI binaries local.
app/src/main/jniLibs/x86/
app/src/main/jniLibs/x86_64/
app/src/main/jniLibs/armeabi-v7a/

# Generated and downloaded test material
app/src/androidTest/assets/lei-jun-test.wav
test-data/download-inspect-*/
test-data/*.wav
*.tar.bz2
zhixi-gateway-bundle.tar.gz

# Android and release artifacts
*.apk
*.aab

# Python

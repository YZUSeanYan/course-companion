# Normalize text files in the repository; keep platform wrappers native.
* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.properties text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.mp3 binary
*.onnx binary
*.so binary
*.jar binary
*.apk binary

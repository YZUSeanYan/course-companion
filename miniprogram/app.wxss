page { background: #FCFCFC; color: #171717; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 28rpx; line-height: 1.65; }
view, text, button, input, textarea { box-sizing: border-box; }
button { margin: 0; font-size: 28rpx; font-weight: 600; line-height: 1.5; border-radius: 36rpx; }
button::after { border: 0; }
button[disabled] { opacity: .48; }
.page { min-height: 100vh; padding: 36rpx 40rpx 70rpx; background: linear-gradient(180deg, #FFF8F3 0, #FCFCFC 460rpx); animation: enter .4s cubic-bezier(.05,.7,.1,1) both; }
.tab-page { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: #A34614; font-size: 21rpx; letter-spacing: 4rpx; font-weight: 600; }
.title { white-space: pre-line; margin: 12rpx 0 16rpx; font-size: 52rpx; line-height: 1.25; font-weight: 700; letter-spacing: -1rpx; }
.subtitle { white-space: pre-line; color: #6F6F6F; font-size: 27rpx; line-height: 1.8; }
.section-title { margin: 36rpx 0 20rpx; font-size: 32rpx; font-weight: 700; }
.row { display: flex; align-items: center; gap: 20rpx; }
.spread { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.stack { display: flex; flex-direction: column; gap: 20rpx; }
.card { padding: 36rpx; border: 1rpx solid #E6E5E3; border-radius: 48rpx; background: rgba(255,255,255,.96); margin-bottom: 20rpx; overflow: hidden; }
.card-accent { background: #FFF1E8; border-color: #FFD9C2; }
.muted { color: #6F6F6F; font-size: 24rpx; }
.label { display: block; font-weight: 600; margin: 26rpx 0 12rpx; }
.field, .textarea { display: block; width: 100%; background: #F3F2F1; border: 1rpx solid #E6E5E3; border-radius: 28rpx; padding: 24rpx; color: #171717; font-size: 28rpx; }
.field { height: 96rpx; }
.textarea { height: 320rpx; line-height: 1.7; }
.button-primary, .button-secondary, .button-ghost { padding: 24rpx 30rpx; transition: transform .15s cubic-bezier(.2,.8,.2,1); }
.button-primary { background: #FF670D; color: #171717; }
.button-secondary { background: #FFF1E8; color: #A33A00; }
.button-ghost { background: transparent; color: #6F6F6F; }
.button-hover { transform: scale(.97); opacity: .92; }
.pill, .badge { display: inline-block; padding: 6rpx 18rpx; background: #F3F2F1; color: #62605E; font-size: 21rpx; border-radius: 24rpx; }
.badge { background: #FFF1E8; color: #A33A00; }
.empty { text-align: center; padding: 52rpx 28rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; margin: 16rpx 0; }
.error { background: #FDECEC; color: #A62228; border: 1rpx solid #F7CED0; border-radius: 24rpx; padding: 24rpx; margin: 20rpx 0; }
.count { font-size: 48rpx; font-weight: 700; line-height: 1.2; }
.divider { border-top: 1rpx solid #E6E5E3; margin: 24rpx 0; }
.body-text { white-space: pre-wrap; overflow-wrap: break-word; word-break: break-word; }
.reduced-motion, .reduced-motion .flip-card, .reduced-motion .progress-fill, .reduced-motion .button-primary, .reduced-motion .button-secondary, .reduced-motion .button-ghost, .reduced-motion .card { animation: none !important; transition: none !important; }
.reduced-motion .button-hover { transform: none; }
@keyframes enter { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }

.session-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.session-heading { margin-bottom: 28rpx; }
.session-title, .course-link { word-break: break-all; }
.course-link { text-align: left; padding: 0 0 12rpx; color: #A33A00; font-size: 27rpx; }
.source-facts { border-radius: 56rpx; }
.source-description { margin: 18rpx 0; font-size: 27rpx; line-height: 1.85; }
.session-actions { display: flex; gap: 18rpx; }
.session-actions button { flex: 1; padding-left: 16rpx; padding-right: 16rpx; }
.action-hint { margin: 18rpx 0 32rpx; }
.section-heading { margin: 40rpx 0 20rpx; }
.section-heading .section-title { margin: 0; }
.body-label { color: #6F6F6F; font-size: 23rpx; margin: 26rpx 0 12rpx; }
.content-text, .source-quote, .transcript-text { display: block; white-space: pre-wrap; word-break: break-all; line-height: 1.9; }
.source-quote { background: #F3F2F1; border-left: 5rpx solid #FF670D; border-radius: 0 20rpx 20rpx 0; padding: 20rpx 24rpx; color: #57524F; font-size: 26rpx; }
.content-text { font-size: 28rpx; }
.doubt-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 28rpx; }
.doubt-actions button { padding: 20rpx 24rpx; font-size: 25rpx; }
.transcript-panel { border-radius: 56rpx; }
.transcript-hint { padding-bottom: 24rpx; border-bottom: 1rpx solid #E6E5E3; margin-bottom: 28rpx; }
.transcript-text { font-size: 30rpx; line-height: 2; }
.empty-note { margin: 12rpx 0 28rpx; }
.archive-section { margin-top: 44rpx; text-align: center; }
.archive-section .button-ghost { margin-top: 12rpx; }

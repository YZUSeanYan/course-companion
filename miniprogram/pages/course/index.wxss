.course-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.course-heading { margin-bottom: 28rpx; }
.course-name, .entry-title, .source-link { word-break: break-all; }
.local-label { margin-top: 20rpx; }
.course-overview { border-radius: 56rpx; }
.overview-stats { display: flex; padding: 4rpx 0 24rpx; }
.overview-stat { width: 50%; }
.overview-stat + .overview-stat { border-left: 1rpx solid #FFD9C2; padding-left: 36rpx; }
.overview-stat .muted { display: block; margin-top: 10rpx; }
.overview-note { color: #6F6F6F; margin-bottom: 28rpx; font-size: 25rpx; }
.section-heading { margin: 40rpx 0 20rpx; }
.section-heading .section-title { margin: 0; }
.section-note { margin: -4rpx 0 20rpx; }
.empty-note { margin: 12rpx 0 28rpx; }
.session-entry { display: block; width: 100%; text-align: left; line-height: 1.65; font-weight: 400; color: #171717; }
.entry-date { color: #6F6F6F; font-size: 23rpx; }
.entry-arrow { color: #E04E00; font-size: 32rpx; }
.entry-title { font-size: 32rpx; font-weight: 600; margin: 12rpx 0; }
.entry-meta { color: #6F6F6F; font-size: 24rpx; }
.card-side-label { font-size: 22rpx; color: #6F6F6F; margin: 24rpx 0 8rpx; }
.card-body { display: block; white-space: pre-wrap; word-break: break-all; font-size: 28rpx; line-height: 1.85; }
.card-source { margin-top: 28rpx; padding-top: 16rpx; border-top: 1rpx solid #E6E5E3; }
.source-link { padding: 10rpx 0; text-align: left; font-size: 24rpx; color: #A33A00; font-weight: 500; }
.archive-card { padding: 14rpx 0 0; text-align: right; font-size: 24rpx; font-weight: 400; }
.archive-section { text-align: center; margin-top: 48rpx; }
.archive-section .button-ghost { margin-top: 12rpx; }

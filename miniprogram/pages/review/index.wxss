.session-meta { margin-top: 36rpx; font-size: 24rpx; color: #6F6F6F; }
.progress-track { height: 8rpx; background: #EEEAE7; border-radius: 6rpx; margin: 18rpx 0 28rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #FF670D; transition: width .2s ease; }
.flip-stage { perspective: 1800rpx; margin-bottom: 28rpx; }
.flip-card { position: relative; height: 580rpx; transform-style: preserve-3d; transition: transform .42s cubic-bezier(.05,.7,.1,1); }
.is-flipped { transform: rotateY(180deg); }
.face { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: flex-start; padding: 36rpx; border-radius: 48rpx; border: 1rpx solid #E6E5E3; background: #FFFFFF; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
.back { transform: rotateY(180deg); background: #FFF1E8; border-color: #FFD9C2; }
.card-body { flex: 1; height: 360rpx; margin: 30rpx 0; font-size: 34rpx; line-height: 1.7; }
.back .card-body { font-size: 30rpx; }
.rating-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.rating { padding: 22rpx 10rpx; background: #F3F2F1; color: #171717; }
.rating text { display: block; font-size: 21rpx; color: #6F6F6F; margin-top: 4rpx; font-weight: 400; }
.again { background: #FDECEC; color: #A62228; }
.easy { background: #FFF1E8; color: #A33A00; }
.finished { margin-top: 40rpx; }
.done-mark { width: 100rpx; height: 100rpx; line-height: 100rpx; margin: 0 auto 28rpx; border-radius: 50%; background: #FFF1E8; color: #A33A00; font-size: 52rpx; }
.done-button { margin-top: 34rpx; }
.algorithm-note { margin-top: 30rpx; color: #6F6F6F; font-size: 22rpx; line-height: 1.8; }

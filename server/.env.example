# Placeholders only. Export real values through your local secret/environment manager.
TOKEN_PEPPER=replace-with-a-long-random-server-pepper
DATABASE_PATH=learning_analysis.db

AI_PROVIDER_BASE_URL=https://provider.example.com/v1
AI_PROVIDER_MODEL=replace-with-model-name
AI_PROVIDER_API_KEY=replace-with-provider-key
# Optional Lecsync gateway. Official origin remains fixed to api.lecsync.com.
LECSYNC_API_KEY=
LECSYNC_UPLOAD_ROOT=lecsync_uploads
LECSYNC_DAILY_TEXT_QUOTA=50000
LECSYNC_DAILY_AUDIO_SECONDS=3600
LECSYNC_RATE_LIMIT=60
LECSYNC_MAX_CONCURRENT_STREAMS=3
# Separate server-admin credential; never place this in the Android app.
LECSYNC_ADMIN_TOKEN=
# Optional externally managed webhook secrets: {"v1":"replace-with-secret"}
LECSYNC_WEBHOOK_SECRETS={}
# Optional ordered failover: deepseek -> kimi -> mimo
DEEPSEEK_API_KEY=
KIMI_API_KEY=
MIMO_API_KEY=
# Optional custom vision provider. When unset, existing MIMO_API_KEY and
# DEEPSEEK_API_KEY are reused automatically as ordered vision fallbacks.
VISION_PROVIDER_BASE_URL=https://vision-provider.example.com/v1
VISION_PROVIDER_MODEL=replace-with-vision-model
VISION_PROVIDER_API_KEY=replace-with-vision-key
# Optional model overrides for the built-in vision fallback chain.
# VISION_MIMO_MODEL=mimo-v2.6-pro
# VISION_DEEPSEEK_MODEL=deepseek-flash
DOCUMENT_STORAGE_ROOT=document_assets
# Optional local parsers, never HTTP loopback:
# MINERU_COMMAND=mineru
# LIBREOFFICE_PATH=libreoffice
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_MAX_RETRIES=2
AI_PROVIDER_RETRY_BACKOFF_SECONDS=0.25

DEVICE_DAILY_QUOTA=20
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
ANALYZE_RATE_LIMIT=30
ANALYZE_RATE_WINDOW_SECONDS=60

# Trial accounts. These values are server-only and never enter the APK.
REQUIRE_ACCOUNT_ACTIVATION=true
USAGE_TIMEZONE=Asia/Shanghai
ACCOUNT_ENCRYPTION_KEY=replace-with-a-long-random-account-key
ACCOUNT_DEFAULT_AI_PACK_DAILY_LIMIT=5
ACCOUNT_DEFAULT_AUDIO_MINUTES_DAILY_LIMIT=60
ACCOUNT_DEFAULT_TEXT_CHARS_DAILY_LIMIT=20000
ACCOUNT_DEFAULT_DOCUMENT_DAILY_LIMIT=5
ACCOUNT_DEFAULT_MAX_DEVICES=3

# Admin dashboard. Leave ADMIN_PASSWORD unset to keep /admin disabled.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=true
ADMIN_DIST_DIR=admin-dist

# Public trial application page. Uses Aliyun PNVS SMS verification
# (dypnsapi SendSmsVerifyCode), not the separate SMS service (Dysms).
# Use an approved system-gifted PNVS sign and template; production uses
# sign 恒创联众 and login/register template 100001.
ALIYUN_SMS_ACCESS_KEY_ID=replace-with-an-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=replace-with-an-access-key-secret
ALIYUN_SMS_SIGN_NAME=replace-with-approved-sign-name
ALIYUN_SMS_TEMPLATE_CODE=replace-with-template-code
ALIYUN_SMS_REGION=cn-hangzhou
TRIAL_DEFAULT_AI_PACKS=5
TRIAL_DEFAULT_AUDIO_MINUTES=30
TRIAL_DEFAULT_VALID_MONTHS=2
TRIAL_CODE_TTL_SECONDS=300
TRIAL_CODE_MAX_ATTEMPTS=5
TRIAL_CODE_RESEND_SECONDS=60
TRIAL_CODE_PER_PHONE_HOUR=5
TRIAL_CODE_PER_IP_HOUR=10
TRIAL_APPLY_PER_IP_HOUR=20
